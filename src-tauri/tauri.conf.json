{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByTune",
  "version": "0.1.0",
  "identifier": "app.bytune.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Desktop music player",
    "longDescription": "ByTune plays the YouTube Music catalog and your own music files in one app, with synced lyrics, downloads, a mini player and listening stats.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/rustypipe-botguard"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    },
    "copyright": "Copyright © 2026 ByTune contributors. GPL-3.0-only.",
    "publisher": "ByTune",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "description": "MP3 audio",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "m4a",
          "aac"
        ],
        "name": "AAC audio",
        "description": "AAC audio",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC audio",
        "description": "FLAC audio",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "description": "WAV audio",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "Ogg audio",
        "description": "Ogg audio",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "Opus audio",
        "description": "Opus audio",
        "role": "Viewer",
        "mimeType": "audio/opus"
      },
      {
        "ext": [
          "aiff",
          "aif"
        ],
        "name": "AIFF audio",
        "description": "AIFF audio",
        "role": "Viewer",
        "mimeType": "audio/aiff"
      },
      {
        "ext": [
          "wma"
        ],
        "name": "Windows Media audio",
        "description": "Windows Media audio",
        "role": "Viewer",
        "mimeType": "audio/x-ms-wma"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RUUzQUVENTVEM0FBNDYKUldSR3F0TlY3VHJ1VjVkVTN4Zmpnc04zYU5ZQ2xIalVYU1VRcnREdnRKRTNaMmZxeWphc3ByYkMK",
      "endpoints": [
        "https://github.com/Sr1ya/bytune-rs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "bytune"
        ]
      }
    }
  }
}
